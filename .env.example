# Copy this file to server/.env and replace the placeholder values.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/badminton_shop?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@badminton.local
ADMIN_PASSWORD=ChangeMe123!

